# --- Supabase (recommended): Project Settings → Database → Connection string (URI) ---
# App runtime: use the free shared POOLER, transaction mode (port 6543).
# no-verify: Supabase pooler chain fails Node's strict verification on some
# networks; traffic is still TLS-encrypted. The paid IPv4 add-on is NOT needed.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=no-verify&pgbouncer=true"

# Migrations/seed: use the SESSION pooler (port 5432, persistent connections
# so DDL works). Same host, no pgbouncer flag.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=no-verify"

# --- Local Postgres alternative (port 5432 on this machine) ---
# DATABASE_URL="postgresql://postgres:<YOUR_PASSWORD>@localhost:5432/portfolio?schema=public"

# JWT signing secret for the admin session cookie
JWT_SECRET="change-me-to-a-long-random-string"

# Cloudinary (image / video / PDF uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
